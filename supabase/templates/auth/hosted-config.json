{
  "mailer_subjects_confirmation": "Confirm your Rallora email",
  "mailer_templates_confirmation_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Welcome to Rallora.</title><style>@media(max-width:440px){.email-outer{padding:16px 10px!important}.email-content{padding:26px 22px!important}.email-title{font-size:28px!important}}p{margin:0 0 15px}a{overflow-wrap:anywhere}</style></head><body style=\"margin:0;padding:0;background:#eaf2f8;font-family:Arial,Helvetica,sans-serif;color:#061a39\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">Confirm your Rallora email</div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td class=\"email-outer\" align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"540\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:540px\"><tr><td><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#ffffff;border-radius:12px;overflow:hidden\"><tr><td align=\"center\" bgcolor=\"#061a39\" style=\"padding:30px 25px;background:#061a39;border-bottom:5px solid #00b0fe\"><img src=\"https://www.rallora.app/brand/rallora-email-logo-final.png\" width=\"274\" alt=\"Rallora — Play Connect Progress\" style=\"display:block;width:274px;max-width:100%;height:auto;margin:0 auto;border:0\"></td></tr><tr><td class=\"email-content\" style=\"padding:32px;color:#536a80;font-size:14px;line-height:1.75\"><p style=\"font-size:10px;font-weight:700;letter-spacing:1.8px;color:#061a39;margin:0 0 12px\">YOUR RALLORA ACCOUNT</p><h1 class=\"email-title\" style=\"font-size:31px;line-height:1.16;letter-spacing:-1px;color:#061a39;margin:0 0 24px\">Welcome to Rallora.</h1><p>Hi there,</p><p>Confirm your email address to finish setting up your Rallora account.</p><p>This link expires and can only be used once. If you did not request this email, you can ignore it. Your account will not change unless you complete the action.</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin-top:24px\"><tr><td align=\"center\" bgcolor=\"#061a39\" style=\"border-radius:7px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:16px 20px;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;border-radius:7px\">Confirm email address</a></td></tr></table><p style=\"margin:23px 0 0;font-size:13px;color:#061a39\">See you on court,<br><strong>The Rallora team</strong></p></td></tr><tr><td style=\"padding:20px 26px;border-top:1px solid #e4edf5;background:#f8fbfe;text-align:center;font-size:12px;line-height:1.75;color:#58718a\">For account help, contact support@rallora.app. Never share your password or verification code.</td></tr></table><p style=\"text-align:center;font-size:11px;color:#6b8093;line-height:1.7;margin:20px 0 0\"><strong style=\"color:#061a39\">Your club. Your league.</strong><br>Rallora · Play. Connect. Progress.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_invite": "You’re invited to Rallora",
  "mailer_templates_invite_content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your place starts here.</title><style>@media(max-width:440px){.email-outer{padding:16px 10px!important}.email-content{padding:26px 22px!important}.email-title{font-size:28px!important}}p{margin:0 0 15px}a{overflow-wrap:anywhere}</style></head><body style=\"margin:0;padding:0;background:#eaf2f8;font-family:Arial,Helvetica,sans-serif;color:#061a39\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">You’re invited to Rallora</div><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td class=\"email-outer\" align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"540\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:540px\"><tr><td><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#ffffff;border-radius:12px;overflow:hidden\"><tr><td align=\"center\" bgcolor=\"#061a39\" style=\"padding:30px 25px;background:#061a39;border-bottom:5px solid #00b0fe\"><img src=\"https://www.rallora.app/brand/rallora-email-logo-final.png\" width=\"274\" alt=\"Rallora — Play Connect Progress\" style=\"display:block;width:274px;max-width:100%;height:auto;margin:0 auto;border:0\"></td></tr><tr><td class=\"email-content\" style=\"padding:32px;color:#536a80;font-size:14px;line-height:1.75\"><p style=\"font-size:10px;font-weight:700;letter-spacing:1.8px;color:#061a39;margin:0 0 12px\">YOUR RALLORA ACCOUNT</p><h1 class=\"email-title\" style=\"font-size:31px;line-height:1.16;letter-spacing:-1px;color:#061a39;margin:0 0 24px\">Your place starts here.</h1><p>Hi there,</p><p>You have been invited to create a Rallora account. Follow the secure link to accept your account invitation.</p><p>This link expires and can only be used once. If you did not request this email, you can ignore it. Your account will not change unless you complete the action.</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin-top:24px\"><tr><td align=\"center\" bgcolor=\"#061a39\" style=\"border-radius:7px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:block;padding:16px 20px;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;border-radius:7px\">Accept account invitation</a></td></tr></table><p style=\"margin:23px 0 0;font-size:13px;color:#061a39\">See you on court,<br><strong>The Rallora team</strong></p></td></tr><tr><td style=\"padding:20px 26px;border-top:1px solid #e4edf5;background:#f8fbfe;text-align:center;font-size:12px;line-height:1.75;color:#58718a\">For account help, contact support@rallora.app. Never share your password or verification code.</td></tr></table><p style=\"text-align:center;font-size:11px;color:#6b8093;line-height:1.7;margin:20px 0 0\"><strong style=\"color:#061a39\">Your club. Your league.</strong><br>Rallora · Play. Connect. Progress.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_magic_link": "Your secure Rallora sign-in link",
