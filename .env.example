# Supabase
# Use the Project URL only, not /rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public production URL used for sitemap/share links
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First club / tenant slug
NEXT_PUBLIC_CLUB_SLUG=gsm-padel

# Rallora Social cloud drafts: OFF until the staging schema is tested with real
# Supabase Auth/Storage, a full database restore is verified and the owner
# approves launch. Do not turn this on against the existing production DB.
RALLORA_SOCIAL_DB_ENABLED=false

# Club administration writes: OFF until membership-scoped RLS and the full
# role-isolation suite have passed. Preview environments must never point this
# flag at the production database.
NEXT_PUBLIC_RALLORA_ENABLE_CLUB_WRITES=false

# Do not set any social OAuth/WhatsApp/AI provider keys until explicit approval.
