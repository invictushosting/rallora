# Supabase
# Use the Project URL only, not /rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Required for trusted Playtomic player-rating sync; never expose in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Public URL used for sitemap/share links.
# Local: http://localhost:3000
# Production: https://www.rallora.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production maintenance gate. Preview deployments are intentionally unaffected.
RALLORA_MAINTENANCE_MODE=false

# Optional comma-separated club slugs allowed through production maintenance mode.
# Example: first-pilot-club,second-pilot-club
# Leave empty until a real pilot club is approved for live access.
RALLORA_PILOT_CLUB_SLUGS=

# Server-only 32-byte base64 key used to encrypt third-party integration secrets.
# Generate and store this in the deployment environment; never commit a real key.
RALLORA_INTEGRATION_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Rallora Social cloud drafts: OFF until the staging schema is tested with real
# Supabase Auth/Storage, a full database restore is verified and the owner
# approves launch. Do not turn this on against the existing production DB.
RALLORA_SOCIAL_DB_ENABLED=false

# Club administration writes: keep OFF until membership-scoped RLS and the full
# role-isolation suite have passed for the target environment.
NEXT_PUBLIC_RALLORA_ENABLE_CLUB_WRITES=false

# Do not set any social OAuth/WhatsApp/AI provider keys until explicit approval.

# Support replies: existing outbound provider. Keep server-only.
RESEND_API_KEY=
# Separate server-only key permitted to retrieve incoming emails.
RESEND_RECEIVING_API_KEY=
# Optional receiving domain (dedicated subdomain or Resend-managed domain).
# Configure email.received webhook at /api/support/inbound before enabling.
SUPPORT_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=


# Opt-in fixture reminders via a verified Twilio WhatsApp sender.
# Keep empty until the sender, utility template and signed inbound webhook are ready.
NEXT_PUBLIC_RALLORA_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_ACCOUNT_SID=
TWILIO_WHATSAPP_AUTH_TOKEN=
TWILIO_WHATSAPP_REMINDER_CONTENT_SID=
TWILIO_WHATSAPP_INBOUND_URL=

# Stripe Connect test mode. Set these only in a preview or local environment with an isolated Supabase database.
RALLORA_STRIPE_SANDBOX_SECRET_KEY=
RALLORA_STRIPE_SANDBOX_CLIENT_ID=
RALLORA_STRIPE_SANDBOX_WEBHOOK_SECRET=
RALLORA_STRIPE_SANDBOX_ORIGIN=
RALLORA_STRIPE_SANDBOX_SUPABASE_URL=
