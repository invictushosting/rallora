# Supabase
# Use the Project URL only, not /rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Required for trusted Playtomic player-rating sync; never expose in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Public URL used for sitemap/share links.
# Local: http://localhost:3000
# Production: https://www.rallora.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production maintenance gate. Preview deployments are intentionally unaffected.
RALLORA_MAINTENANCE_MODE=false

# Server-only 32-byte base64 key used to encrypt third-party integration secrets.
# Generate and store this in the deployment environment; never commit a real key.
RALLORA_INTEGRATION_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Rallora Social cloud drafts: OFF until the staging schema is tested with real
# Supabase Auth/Storage, a full database restore is verified and the owner
# approves launch. Do not turn this on against the existing production DB.
RALLORA_SOCIAL_DB_ENABLED=false

# Club administration writes: keep OFF until membership-scoped RLS and the full
# role-isolation suite have passed for the target environment.
NEXT_PUBLIC_RALLORA_ENABLE_CLUB_WRITES=false

# Do not set any social OAuth/WhatsApp/AI provider keys until explicit approval.
